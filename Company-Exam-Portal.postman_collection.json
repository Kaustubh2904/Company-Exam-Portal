              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"question_id\": 1,\n      \"selected_option\": \"A\",\n      \"marked_for_review\": false\n    },\n    {\n      \"question_id\": 2,\n      \"selected_option\": \"C\",\n      \"marked_for_review\": true\n    },\n    {\n      \"question_id\": 3,\n      \"selected_option\": null,\n      \"marked_for_review\": false\n    }\n  ]\n}"
