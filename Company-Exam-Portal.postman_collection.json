    {
      "name": "👑 Admin — Companies",
      "item": [
        {
          "name": "Get All Companies",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/companies?status_filter=pending&skip=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "companies"],
              "query": [
                { "key": "status_filter", "value": "pending", "description": "pending | approved | suspended | rejected | all" },
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "List all companies. Filter by status: pending, approved, suspended, rejected, all."
          }
        },
        {
          "name": "Approve / Suspend Company",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_approved\": true,\n  \"notes\": \"Looks good!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/companies/{{companyId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "companies", "{{companyId}}", "approve"]
            },
            "description": "Set `is_approved: true` to approve, `false` to suspend."
          }
        },
        {
          "name": "Reject Company",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Incomplete registration details\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/companies/{{companyId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "companies", "{{companyId}}", "reject"]
            },
            "description": "Permanently reject a company (logo deleted from disk)."
          }
        },
        {
          "name": "Delete Company",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "companies", "{{companyId}}"]
            },
            "description": "Delete a company. Fails if the company has existing drives."
          }
        }
      ]
    },
