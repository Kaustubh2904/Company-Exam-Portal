            "body": {
              "mode": "raw",
              "raw": "{\n  \"violation_type\": \"tab_switch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/exam/violation?token={{studentToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "exam", "violation"],
              "query": [
                { "key": "token", "value": "{{studentToken}}" }
              ]
            },
            "description": "Report an anti-cheat violation from the frontend.\n\n**Violation types:** `tab_switch`, `fullscreen_exit`, `right_click`, `screenshot`, `copy`, `paste`\n\n**Auto-disqualification thresholds:**\n- `tab_switch`: 3\n- `fullscreen_exit`: 3\n- `right_click`: 3\n- `screenshot`: 1\n- `copy` / `paste`: warning only (no disqualification)"
          }
        },
        {
          "name": "Submit Exam",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
