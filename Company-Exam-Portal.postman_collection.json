            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', json.access_token);",
                  "    console.log('Student token saved:', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"access_token\": \"<student-access-token-uuid>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "auth", "login"]
